async function gSave(){
  if(gSave.busy||!ui.g)return;gSave.busy=1;
  try{
    const g=ui.g;gNormAll();
    const E=gErrors();
    if(E.length){g.show=true;const r0=g.rows[E[0].i];if(!gVisible(r0))g.month=monthOf(r0.d);renderGrid();gFocus(E[0].i,E[0].j);return flash(`${E.length} cell${E.length>1?"s":""} need fixing — marked in red.`,1)}
    g.show=false;
    if(g.rows.some(r=>!r.id&&!gBlank(r)&&lockedDate(r.d)))return flash("A new row belongs to a closed month. Ask a manager to reopen it.",1);
    const u=me(),now=new Date().toISOString(),prev=new Map(st.businessReportBook.map(x=>[x.id,x]));
    let add=0,chg=0;
    const out=g.rows.filter(r=>!gBlank(r)).map(r=>{
      const p=r.id&&prev.get(r.id);
      if(p&&lockedDate(p.d))return p; // closed month: never changed
      const o={};GCOLS.forEach((c,j)=>{const x=r.v[j];o[c.k]=c.num?(x===""?null:Number(x)):x});
      if(p){if(GCOLS.every(c=>p[c.k]===o[c.k]))return p;chg++;return{...p,...o,uby:u.id,uts:now}}
      add++;return{id:uid(),d:r.d,...o,by:u.id,ts:now};
    });
    const keepIds=new Set(out.map(o=>o.id)),gone=st.businessReportBook.filter(x=>!keepIds.has(x.id));
    if(gone.some(x=>lockedDate(x.d)))return flash("Rows in a closed month cannot be removed.",1);
    if(!add&&!chg&&!gone.length){renderGrid();return flash("Nothing has changed.")}
    if(gone.length){const v=await ask(`Remove ${gone.length} saved row${gone.length>1?"s":""}?`,[],"Save");if(!v)return}
    st.businessReportBook=out;
    log("report.save",`added ${add}, changed ${chg}, removed ${gone.length} · ${out.length} rows in table`);
    flash(`Saved ${out.length} row${out.length===1?"":"s"}.`);ui.g.dirty=false;commit();
  }finally{gSave.busy=0}
}
