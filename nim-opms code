async function upPDF(){
  const err=m=>{$("err").textContent=m};
  const n=$("upn").value.replace(/\s+/g," ").trim(),f=$("upf").files&&$("upf").files[0];
  if(!n)return err("Name the document first — a PDF cannot be uploaded without a name.");
  if(n.length<3)return err("The name must be at least 3 characters.");
  if(/[\\\/:*?"<>|\u0000-\u001f]/.test(n))return err('The name cannot contain \\ / : * ? " < > |');
  if(st.docs.some(d=>d.name.toLowerCase()===n.toLowerCase()))return err("A document with this name already exists. Use a different name.");
  if(!f)return err("Choose a PDF file.");
  if(!/\.pdf$/i.test(f.name)||(f.type&&f.type!=="application/pdf"))return err("Only PDF files are accepted.");
  if(!f.size)return err("This file is empty.");
  if(f.size>MAXPDF)return err("This file is larger than 10 MB.");
  const buf=await readBuf(f);let head="";
  for(const b of new Uint8Array(buf.slice(0,1024)))head+=String.fromCharCode(b);
  if(!head.includes("%PDF-"))return err("This file is not a real PDF, so it was not accepted.");
  const id=uid();
  try{await idb.put(id,buf)}catch(e){return err("This browser could not store the file (private window or storage full).")}
  st.docs.push({id,name:n,file:f.name,size:f.size,by:me().id,ts:new Date().toISOString()});
  log("doc.upload",`${n} · ${f.name} · ${fsize(f.size)}`);flash("PDF uploaded.");commit();
}
