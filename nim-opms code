views.close=()=>{
  const u=me(),usable=usableAccts(u),today=ago(0);
  if(!usable.length)return main(`<section class="card empty">No accounts are assigned to you.</section>`);
  let a=acct(ui.cacct);if(!a||!canUse(u,a))a=usable[0];ui.cacct=a.id;
  const d=ui.cd&&ui.cd<=today?ui.cd:today;ui.cd=d;
  const o=bal(a.id,d),t=dayT(a.id,d),exp=rd(o+t.i-t.o),cl=closingOf(a.id,d);ui.exp=exp;
  const pend=st.tx.filter(x=>x.acct===a.id&&x.d===d&&x.status==="pending").length,prior=unclosed(a.id,d);
  const chips=usable.flatMap(x=>unclosed(x.id,"9999-12-31").map(dt=>[x,dt]));
  let body;
  if(cl)body=`<div class="sum"><span>Counted / statement</span><b class="num">${fmt(a.cur,cl.counted)}</b><span>Variance</span><b class="num ${cl.v<0?"out-t":cl.v>0?"in-t":""}">${fmt(a.cur,cl.v)}</b><span>Closed by</span><b>${esc(uname(cl.by))}</b><span>Status</span><b>${badge(cl.status)}</b></div>${cl.note?`<div class="note">Note: ${esc(cl.note)}</div>`:""}`;
  else if(isLocked(a.id,d))body=`<div class="note">A later day is already closed for this account, and nothing was recorded on this date.</div>`;
  else if(prior.length)body=`<div class="warn">Close earlier days first: ${prior.join(", ")}.</div>`;
  else if(pend)body=`<div class="warn">${pend} entr${pend>1?"ies are":"y is"} still pending approval for this day. Approve or reject ${pend>1?"them":"it"} before closing.</div>`;
  else body=`<form id="cl" novalidate><label>${a.type==="cash"?"Cash counted":"Statement / app balance"} (${a.cur})<input id="cnt" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00"></label>
