const BMAX=2000;
st.bondCloses=st.bondCloses||[]; // table added in v6: older saved data gets it empty
if(st.bondsRegistry.some(x=>!x.d)){ // rows saved before v6 had no date: use the day they were saved
  st.bondsRegistry.forEach(x=>{if(!x.d)x.d=x.ts?iso(new Date(x.ts)):ago(0)});save();
}
const bClosed=m=>st.bondCloses.find(c=>c.m===m);
const bLocked=d=>!!bClosed(monthOf(d));
const bLastClosed=()=>st.bondCloses.reduce((a,c)=>c.m>a?c.m:a,"");
const bNorm=(c,v)=>{
  v=String(v==null?"":v).replace(/\s+/g," ").trim();
  if(c.k==="truck")return v.toUpperCase();
  if(c.num){const s=v.replace(/\s/g,"");return /^\d{1,3}(,\d{3})+(\.\d+)?$/.test(s)?s.replace(/,/g,""):s}
  return v;
};
const bErr=(c,v)=>{
  if(!v)return c.req?"Required":"";
  if(v.length>(c.max||16))return"Too long (max "+(c.max||16)+" characters)";
  if(c.k==="truck"&&!/^[A-Z0-9][A-Z0-9 \-\/]{2,14}$/.test(v))return"3–15 letters or numbers (spaces and hyphens allowed)";
  if(c.num){if(!/^\d+(\.\d{1,3})?$/.test(v))return"Numbers only, up to 3 decimals";if(!(+v>0))return"Must be above zero";if(+v>999999999)return"Too large"}
  if(c.ref&&!/^[A-Za-z0-9][A-Za-z0-9\/\-_. ]{1,29}$/.test(v))return"2–30 characters: letters, numbers, / - _ .";
  return"";
};
const bBlank=r=>r.v.every(x=>!String(x).trim());
const bNew=()=>({id:null,d:ago(0),v:BCOLS.map(()=>""),sel:false,touch:{}});
const bVisible=r=>!ui.b.month||monthOf(r.d)===ui.b.month;
function bLoad(keepMonth){
  const rows=st.bondsRegistry.map(x=>({id:x.id,d:x.d,v:BCOLS.map(c=>x[c.k]==null?"":String(x[c.k])),sel:false,touch:{}}));
  const cm=monthOf(ago(0));
  if(!bLocked(ago(0)))while(rows.filter(r=>monthOf(r.d)===cm).length<5)rows.push(bNew());
  ui.b={rows,dirty:false,show:false,by:sess,month:keepMonth==null?cm:keepMonth};
}
function bNormAll(){ui.b.rows.forEach(r=>{if(!bLocked(r.d))r.v=r.v.map((x,j)=>bNorm(BCOLS[j],x))})}
function bErrors(){const out=[];ui.b.rows.forEach((r,i)=>{if(bBlank(r)||bLocked(r.d))return;BCOLS.forEach((c,j)=>{const m=bErr(c,bNorm(c,r.v[j]));if(m)out.push({i,j,m})})});return out}
function bCellErr(r,j){if(bBlank(r)||bLocked(r.d)||!(ui.b.show||r.touch[j]))return"";const c=BCOLS[j];return bErr(c,bNorm(c,r.v[j]))}
function bStat(){
