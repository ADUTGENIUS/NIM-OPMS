  else if(k==="ArrowUp"){if(p>0)go(V[p-1],j);else if(sel)e.preventDefault()}
  else if(k==="ArrowLeft"){if(j>0&&(sel||(s===0&&(t===0||t===len))))go(i,j-1)}
