}
function bDelete(){
  ui.b.rows.forEach(r=>{if(bLocked(r.d))r.sel=false});
  const n=ui.b.rows.filter(r=>r.sel).length;
  if(!n)return flash("Tick the rows you want to delete first (rows in a closed month cannot be deleted).",1);
  ui.b.rows=ui.b.rows.filter(r=>!r.sel);
  const cm=monthOf(ago(0));
  if(!bLocked(ago(0))&&!ui.b.rows.some(r=>monthOf(r.d)===cm))ui.b.rows.push(bNew());
  ui.b.dirty=true;renderBonds();flash(`${n} row${n>1?"s":""} removed — press Save to keep the change.`);
}
async function bSave(){
  if(bSave.busy||!ui.b)return;bSave.busy=1;
  try{
    const g=ui.b;bNormAll();
    const E=bErrors();
    if(E.length){g.show=true;const r0=g.rows[E[0].i];if(!bVisible(r0))g.month=monthOf(r0.d);renderBonds();bFocus(E[0].i,E[0].j);return flash(`${E.length} cell${E.length>1?"s":""} need fixing — marked in red.`,1)}
    g.show=false;
    if(g.rows.some(r=>!r.id&&!bBlank(r)&&bLocked(r.d)))return flash("A new row belongs to a closed month. Ask a manager to reopen it.",1);
    const u=me(),now=new Date().toISOString(),prev=new Map(st.bondsRegistry.map(x=>[x.id,x]));
    let add=0,chg=0;
    const out=g.rows.filter(r=>!bBlank(r)).map(r=>{
      const p=r.id&&prev.get(r.id);
      if(p&&bLocked(p.d))return p; // closed month: never changed
      const o={};BCOLS.forEach((c,j)=>{o[c.k]=c.num?Number(r.v[j]):r.v[j]});
      if(p){if(BCOLS.every(c=>p[c.k]===o[c.k]))return p;chg++;return{...p,...o,uby:u.id,uts:now}}
      add++;return{id:uid(),d:r.d,...o,by:u.id,ts:now};
    });
    const keep=new Set(out.map(o=>o.id)),gone=st.bondsRegistry.filter(x=>!keep.has(x.id));
    if(gone.some(x=>bLocked(x.d)))return flash("Rows in a closed month cannot be removed.",1);
    if(!add&&!chg&&!gone.length){g.dirty=false;renderBonds();return flash("Nothing has changed.")}
    if(gone.length){const v=await ask(`Remove ${gone.length} saved row${gone.length>1?"s":""}?`,[],"Save");if(!v)return}
    st.bondsRegistry=out;
    log("bonds.save",`added ${add}, changed ${chg}, removed ${gone.length} · ${out.length} rows in table`);
    flash(`Saved ${out.length} row${out.length===1?"":"s"}.`);ui.b.dirty=false;commit();
