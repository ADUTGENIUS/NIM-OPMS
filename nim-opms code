/* ---------- actions ---------- */
const acts={
  tab:b=>{ui.tab=b.dataset.t;render()},
  theme:()=>{const r=document.documentElement;const dark=getComputedStyle(r).getPropertyValue("--bg").trim()==="#0e171b";r.dataset.theme=dark?"light":"dark"},
  logout:()=>{log("logout");save();sess=null;ui.g=null;try{sessionStorage.removeItem("cb.s")}catch(e){}render()},
  type:b=>{ui.type=b.dataset.t;document.querySelectorAll(".seg button").forEach(x=>x.className=x===b?"on "+ui.type:"");fillCats()},
  mypin:async()=>{
    const u=me(),v=await ask("Change your PIN",[{k:"o",label:"Current PIN",type:"password",req:1,attr:'inputmode="numeric" maxlength="6"'},{k:"n",label:"New PIN (4–6 digits)",type:"password",req:1,attr:'inputmode="numeric" maxlength="6"'}],"Change PIN");
    if(!v)return;if(u.pin!==hp(v.o))return flash("Current PIN is wrong.",1);if(!validPin(v.n))return flash("PIN must be 4–6 digits.",1);
    u.pin=hp(v.n);u.dp=false;log("pin.change","");save();flash("PIN changed.");render();
  },
  pin:async b=>{
    const t=user(b.dataset.id),v=await ask("New PIN for "+t.name,[{k:"n",label:"New PIN (4–6 digits)",type:"password",req:1,attr:'inputmode="numeric" maxlength="6"'}],"Reset PIN");
    if(!v)return;if(!validPin(v.n))return flash("PIN must be 4–6 digits.",1);
    t.pin=hp(v.n);t.dp=false;log("pin.reset",t.name);save();flash("PIN reset.");render();
  },
  ustat:b=>{
    const t=user(b.dataset.id),mg=st.users.filter(u=>u.active&&u.role==="manager");
    if(t.active&&t.id===sess)return flash("You cannot deactivate yourself.",1);
    if(t.active&&t.role==="manager"&&mg.length<2)return flash("Keep at least one active manager.",1);
    t.active=!t.active;log(t.active?"staff.activate":"staff.deactivate",t.name);commit();
  },
  void:async b=>{
    const x=st.tx.find(t=>t.id===b.dataset.id);if(!x||!canVoid(x))return;
    const legs=x.g?st.tx.filter(t=>t.g===x.g):[x];
    if(legs.some(t=>isLocked(t.acct,t.d)))return flash("One side of this transfer is on a closed day.",1);
    const v=await ask(legs.length>1?"Void transfer (both sides)":"Void entry",[{k:"r",label:"Reason",req:1,attr:'maxlength="100"'}],"Void");if(!v)return;
    legs.forEach(t=>{t.status="void";t.reason=v.r});
    log("entry.void",`${fmt(acct(x.acct).cur,x.a)} ${x.n} – ${v.r}`);commit();
  },
  approve:b=>{
    const x=st.tx.find(t=>t.id===b.dataset.id),u=me();if(!x||x.status!=="pending"||!canUse(u,acct(x.acct)))return;
    if(isLocked(x.acct,x.d))return flash("That day is already closed.",1);
    x.status="posted";x.appr=u.id;log("entry.approve",`${fmt(acct(x.acct).cur,x.a)} ${x.n} (by ${uname(x.by)})`);flash("Approved.");commit();
  },
  reject:async b=>{
    const x=st.tx.find(t=>t.id===b.dataset.id),u=me();if(!x||x.status!=="pending"||!canUse(u,acct(x.acct)))return;
    const v=await ask("Reject entry",[{k:"r",label:"Reason",req:1,attr:'maxlength="100"'}],"Reject");if(!v)return;
    x.status="rejected";x.reason=v.r;x.appr=u.id;log("entry.reject",`${x.n} – ${v.r}`);commit();
  },
  csv:()=>{
    const L=filtered();
    csv("cashbook-ledger.csv",[["Date","Account","Currency","Type","Category","Description","Amount","Status","Entered by","Approved by","Time"],...L.map(x=>{const a=acct(x.acct);return[x.d,a.name,a.cur,x.t,x.c,x.n,x.a,x.status,uname(x.by),x.appr?uname(x.appr):"",x.ts]})]);
  },
  pick:b=>{ui.cacct=b.dataset.a;ui.cd=b.dataset.d;views.close()},
  rec:async b=>{
    const c=st.closings.find(x=>x.id===b.dataset.id),u=me();if(!c||c.status!=="closed")return;
    if(c.by===u.id&&u.role!=="manager")return flash("Someone else must reconcile your closing.",1);
    const v=await ask("Reconcile "+acct(c.acct).name+" · "+c.d,[{k:"n",label:"Note (optional)",attr:'maxlength="120"'}],"Reconcile");if(!v)return;
    c.status="reconciled";c.rby=u.id;c.rts=new Date().toISOString();if(v.n)c.rnote=v.n;
    log("close.reconcile",`${acct(c.acct).name} ${c.d} variance ${fmt(acct(c.acct).cur,c.v)}`);flash("Reconciled.");commit();
  },
  reopen:async b=>{
    const c=st.closings.find(x=>x.id===b.dataset.id);if(!c)return;
    if(c.d!==lockedThru(c.acct))return flash("Reopen the most recent closed day first.",1);
    const v=await ask("Reopen "+acct(c.acct).name+" · "+c.d,[{k:"r",label:"Reason",req:1,attr:'maxlength="100"'}],"Reopen");if(!v)return;
    st.tx=st.tx.filter(x=>x.close!==c.id);st.closings=st.closings.filter(x=>x.id!==c.id);
    log("close.reopen",`${acct(c.acct).name} ${c.d} – ${v.r}`);commit();
  }
};
function csv(name,rows){
  const q=v=>{let s=String(v);if(/^[=+\-@\t\r]/.test(s)&&isNaN(Number(s)))s="'"+s;return`"${s.replace(/"/g,'""')}"`};
  const url=URL.createObjectURL(new Blob(["\ufeff"+rows.map(r=>r.map(q).join(",")).join("\n")],{type:"text/csv"}));
  const a=document.createElement("a");a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
}

/* ---------- forms ---------- */
const forms={
  login:()=>{
    const err=m=>{$("err").textContent=m};
    if(Date.now()<ui.until)return err(`Too many attempts. Wait ${Math.ceil((ui.until-Date.now())/1000)}s.`);
    const u=user($("lu").value);
    if(u&&u.active&&u.pin===hp($("lp").value)){
      ui.fail=0;sess=u.id;try{sessionStorage.setItem("cb.s",sess)}catch(e){}
      log("login","");save();ui.tab="";render();
    }else{
      ui.fail++;if(ui.fail>=5){ui.until=Date.now()+30000;ui.fail=0}
      log("login.failed",u?u.name:"",u?u.id:null);save();err("Wrong PIN.");$("lp").value="";
    }
  },
  f:()=>{
    const u=me(),a=acct($("acct").value),d=$("date").value,n=$("desc").value.trim(),amt=rd(parseFloat($("amt").value));
    const err=m=>{$("err").textContent=m};
    if(!a||!canUse(u,a))return err("Choose an account.");
    if(!d||d>ago(0))return err("Choose a valid date (not in the future).");
    if(isLocked(a.id,d))return err(`${a.name} is closed through ${lockedThru(a.id)}. Use a later date.`);
    if(!(amt>0))return err("Enter an amount greater than zero.");
    if(!n)return err("Add a short description.");
    const x={id:uid(),d,acct:a.id,t:ui.type,c:$("cat").value,n,a:amt,by:u.id,status:u.role==="field"?"pending":"posted",ts:new Date().toISOString()};
    st.tx.push(x);log("entry."+x.status,`${x.t} ${fmt(a.cur,amt)} · ${a.name} · ${n}`);
    flash(x.status==="pending"?"Submitted for approval.":"Entry saved.");commit();
  },
  x:()=>{
    const u=me(),k=xCalc(),err=m=>{$("xerr").textContent=m},d=ago(0);
    if(!k)return err("Choose both accounts.");
    if(k.f.id===k.t.id)return err("Choose two different accounts.");
    if(!canUse(u,k.f)||!canUse(u,k.t))return err("You cannot use one of these accounts.");
    if(!(k.a>0))return err("Enter an amount.");
    if(!k.same&&!(k.r>0))return err("Enter a valid rate.");
    if(!(k.got>0))return err("Amount is too small to convert.");
    for(const a of [k.f,k.t])if(isLocked(a.id,d))return err(`${a.name} is already closed for today.`);
    const g=uid(),ts=new Date().toISOString(),c=k.same?"Transfer":"Currency exchange",note=k.same?"":` @ ${k.r.toLocaleString("en-US")} SSP/USD`;
    st.tx.push({id:uid(),g,d,acct:k.f.id,t:"out",c,n:`To ${k.t.name}${note}`,a:k.a,by:u.id,status:"posted",ts});
    st.tx.push({id:uid(),g,d,acct:k.t.id,t:"in",c,n:`From ${k.f.name}${note}`,a:k.got,by:u.id,status:"posted",ts});
    log("transfer",`${fmt(k.f.cur,k.a)} ${k.f.name} → ${fmt(k.t.cur,k.got)} ${k.t.name}`);flash("Transfer posted.");commit();
  },
  cl:()=>{
    const u=me(),a=acct(ui.cacct),d=ui.cd,err=m=>{$("err").textContent=m};
    if(!canUse(u,a)||u.role==="field")return err("You cannot close this account.");
    if(closingOf(a.id,d)||isLocked(a.id,d))return err("This day is already closed.");
    if(unclosed(a.id,d).length)return err("Close earlier days first.");
    if(st.tx.some(x=>x.acct===a.id&&x.d===d&&x.status==="pending"))return err("Resolve pending entries first.");
    const cnt=parseFloat($("cnt").value);if(!isFinite(cnt)||cnt<0)return err("Enter the counted amount.");
    const exp=rd(bal(a.id,d)+dayT(a.id,d).i-dayT(a.id,d).o),counted=rd(cnt),v=rd(counted-exp),note=$("cnote").value.trim();
    if(v!==0&&!note)return err("Explain the variance in the note.");
    const ts=new Date().toISOString(),cl={id:uid(),acct:a.id,d,exp,counted,v,note,by:u.id,ts,status:"closed"};
    if(v!==0)st.tx.push({id:uid(),d,acct:a.id,t:v>0?"in":"out",c:"Cash over/short",n:`Closing adjustment (${v>0?"over":"short"})`,a:Math.abs(v),by:u.id,status:"posted",ts,adj:1,close:cl.id});
    st.closings.push(cl);log("close",`${a.name} ${d}: expected ${fmt(a.cur,exp)}, counted ${fmt(a.cur,counted)}, variance ${fmt(a.cur,v)}`);
    flash(v===0?"Day closed — no variance.":"Day closed with a variance.");commit();
  },
  na:()=>{
    const err=m=>{$("err").textContent=m},n=$("nan").value.trim(),o=rd(parseFloat($("nao").value)||0);
    if(!n)return err("Enter a name.");
    if(st.accounts.some(a=>a.name.toLowerCase()===n.toLowerCase()))return err("An account with that name exists.");
    const roles=[];if($("naf").checked)roles.push("field");if($("nak").checked)roles.push("cashier");
    st.accounts.push({id:"a"+uid(),name:n,cur:$("nac").value,type:$("nat").value,roles,opening:o,active:true});
    log("account.add",`${n} (${$("nac").value})`);flash("Account added.");commit();
