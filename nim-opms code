const PCOLS=[
  {k:"consignee",label:"Consignee names",req:1,max:80,w:190},
  {k:"truck",label:"Truck number",req:1,max:15,w:120},
  {k:"ssp",label:"SSP payment",num:1,w:120},
  {k:"adj",label:"Adjustment (SSP)",num:1,neg:1,w:130},
  {k:"usd",label:"USD payment",num:1,w:120},
  {k:"coc",label:"SSNBS-COC payment",num:1,w:140},
  {k:"agent",label:"Agent fee payment",num:1,w:130},
  {k:"wb",label:"Weight bridge payment (USD)",num:1,w:160},
  {k:"remark",label:"Remark",opts:["Confirm","Reject"],w:130}
