const gRowTotal=r=>{let t=0;GCOLS.forEach((c,j)=>{if(c.num){const x=gNorm(c,r.v[j]),v=x===""?NaN:Number(x);if(isFinite(v))t+=v}});return Math.round(t*100)/100};
