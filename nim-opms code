const gDate=v=>{ // accepts YYYY-MM-DD, DD/MM/YYYY, DD-MM-YYYY, DD.MM.YYYY (day first); returns YYYY-MM-DD or the text unchanged
  let m=v.match(/^(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})$/),y,mo,d;
  if(m){y=+m[1];mo=+m[2];d=+m[3]}
  else if(m=v.match(/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{2}|\d{4})$/)){d=+m[1];mo=+m[2];y=+m[3];if(y<100)y+=2000}
  else return v;
  const t=new Date(Date.UTC(y,mo-1,d));
  return t.getUTCFullYear()===y&&t.getUTCMonth()===mo-1&&t.getUTCDate()===d?y+"-"+pad(mo)+"-"+pad(d):v;
};
const gNorm=(c,v)=>{
  v=String(v==null?"":v).replace(/\s+/g," ").trim();
  if(c.k==="truck")return v.toUpperCase();
  if(c.date)return gDate(v);
  if(c.opts){const l=v.toLowerCase();return c.opts.find(o=>o.toLowerCase()===l||o.toLowerCase()+"ed"===l)||v}
  if(c.num){const s=v.replace(/\s/g,"");return /^-?\d{1,3}(,\d{3})+(\.\d+)?$/.test(s)?s.replace(/,/g,""):s}
  return v;
};
const gErr=(c,v)=>{
  if(!v)return c.req?"Required":"";
  if(c.max&&v.length>c.max)return"Too long (max "+c.max+" characters)";
  if(c.k==="truck"&&!/^[A-Z0-9][A-Z0-9 \-\/]{2,14}$/.test(v))return"3–15 letters or numbers (spaces and hyphens allowed)";
  if(c.opts&&!c.opts.includes(v))return"Choose Confirm or Reject";
  if(c.date){
    if(!/^\d{4}-\d{2}-\d{2}$/.test(v))return"Enter a real date, e.g. 2026-10-18 or 18/10/2026";
    if(v<"2000-01-01")return"Date is too far in the past";
    if(v>ago(0))return"Arrival cannot be in the future";
    return"";
  }
  if(c.num){
    if(!(c.neg?/^-?\d+(\.\d{1,2})?$/:/^\d+(\.\d{1,2})?$/).test(v))return c.neg?"Numbers only (minus allowed), up to 2 decimals":"Numbers only, up to 2 decimals";
    if(Math.abs(+v)>GBIG)return"Too large";
  }
  return"";
};
const gBlank=r=>r.v.every(x=>!String(x).trim());
