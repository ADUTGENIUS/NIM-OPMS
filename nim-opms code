}
function bAdd(col){
  const cm=monthOf(ago(0));
  if(bLocked(ago(0)))return flash(`${fmtMonth(cm)} is closed. A manager must reopen it before new rows can be added.`,1);
  const R=ui.b.rows;if(R.length>=BMAX)return flash("Row limit reached ("+BMAX+").",1);
  R.push(bNew());
  if(ui.b.month&&ui.b.month!==cm){ui.b.month=cm;renderBonds();return bFocus(R.length-1,col||0)}
  $("brb").insertAdjacentHTML("beforeend",bRowHTML(R[R.length-1],R.length-1,R.filter(bVisible).length));
