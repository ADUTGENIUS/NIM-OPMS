  const H=st.closings.filter(c=>viewAccts(u).some(x=>x.id===c.acct)).sort((x,y)=>y.d.localeCompare(x.d)||y.ts.localeCompare(x.ts)).slice(0,60);
  main(`<div class="cols"><section class="card"><h2>Close the day</h2>
    ${chips.length?`<div class="note" style="margin-bottom:8px">Needs closing:</div><div class="chips" style="margin-bottom:12px">${chips.map(([x,dt])=>`<button class="ghost" type="button" data-act="pick" data-a="${x.id}" data-d="${dt}">${esc(x.name)} · ${dt}</button>`).join("")}</div>`:""}
    <div style="display:grid;gap:10px"><label>Account<select id="cacct">${usable.map(x=>`<option value="${x.id}" ${x.id===a.id?"selected":""}>${esc(x.name)} (${x.cur})</option>`).join("")}</select></label>
    <label>Date<input type="date" id="cd" max="${today}" value="${d}"></label>
    <div class="sum"><span>Opening</span><b class="num">${fmt(a.cur,o)}</b><span>Money in</span><b class="num in-t">${fmt(a.cur,t.i)}</b><span>Money out</span><b class="num out-t">${fmt(a.cur,t.o)}</b><span>Expected closing</span><b class="num">${fmt(a.cur,exp)}</b></div>${body}</div></section>
  <section class="card"><h2>Closings &amp; reconciliation</h2>${H.length?`<div class="tw"><table><thead><tr><th>Date</th><th>Account</th><th class="r">Expected</th><th class="r">Counted</th><th class="r">Variance</th><th>Closed by</th><th>Status</th><th></th></tr></thead><tbody>
  ${H.map(c=>{const x=acct(c.acct);const canRec=c.status==="closed"&&seesAll(u)&&(c.by!==u.id||u.role==="manager");const canRe=u.role==="manager"&&c.d===lockedThru(c.acct);
    return`<tr><td class="num">${c.d}</td><td>${esc(x.name)}</td><td class="r num">${fmt(x.cur,c.exp)}</td><td class="r num">${fmt(x.cur,c.counted)}</td><td class="r num ${c.v<0?"out-t":c.v>0?"in-t":""}">${fmt(x.cur,c.v)}</td><td>${esc(uname(c.by))}</td><td>${badge(c.status)}${c.rby?`<div class="note">by ${esc(uname(c.rby))}</div>`:""}</td><td>${canRec?`<button class="ghost" type="button" data-act="rec" data-id="${c.id}">Reconcile</button> `:""}${canRe?`<button class="ghost bad" type="button" data-act="reopen" data-id="${c.id}">Reopen</button>`:""}</td></tr>`}).join("")}</tbody></table></div>
  <div class="note" style="margin-top:8px">The person who closes a day cannot reconcile it (managers excepted). A variance is posted as a "Cash over/short" entry so the books match the count.</div>`:`<div class="empty">No days closed yet.</div>`}</section></div>`);
  const c=$("cnt");if(c)c.focus();
};

