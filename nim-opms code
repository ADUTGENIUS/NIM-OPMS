function bFocus(i,j){const el=document.querySelector(`#brb .rc[data-r="${i}"][data-c="${j}"]`);if(el){el.focus();el.select()}}
function bBar(){
  const el=$("brbar");if(!el||!ui.b)return;
  const u=me(),today=ago(0),cm=monthOf(today),m=ui.b.month,cl=m&&bClosed(m);
  const ms=[...new Set([cm,...st.bondsRegistry.map(x=>monthOf(x.d)),...ui.b.rows.map(r=>monthOf(r.d)),...st.bondCloses.map(c=>c.m)])].sort().reverse();
