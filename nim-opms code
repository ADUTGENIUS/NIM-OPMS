  <label>Month<select id="bmonth"><option value=""${m===""?" selected":""}>All months</option>${ms.map(x=>`<option value="${x}"${x===m?" selected":""}>${esc(fmtMonth(x))}${bClosed(x)?" (closed)":""}</option>`).join("")}</select></label>
  <div>${m?(cl?`<span class="bd closed">Closed</span> <span class="note">by ${esc(uname(cl.by))} on ${esc(cl.ts.slice(0,10))}</span>`:'<span class="bd">Open</span>'):""}</div>
