const BCOLS=[
  {k:"consignee",label:"Consignee names",req:1,max:80,w:190},
  {k:"truck",label:"Truck number",req:1,max:15,w:120},
  {k:"goods",label:"Goods description",req:1,max:120,w:220},
  {k:"qty",label:"Quantity",req:1,num:1,w:100},
  {k:"cvet",label:"Agent declaration (CVET)",max:30,ref:1,w:170},
  {k:"cuda",label:"Customs declaration (CUDA)",max:30,ref:1,w:180},
  {k:"remark",label:"Remark",max:200,w:200}
