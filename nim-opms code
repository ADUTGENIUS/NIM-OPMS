    const early=[...new Set(st.paymentRecords.map(x=>monthOf(x.d)))].filter(k=>k<m&&!pClosed(k)).sort();
    if(early.length)return flash("Close earlier months first: "+early.map(fmtMonth).join(", ")+".",1);
    const v=await ask(`Close ${fmtMonth(m)}? ${n} row${n>1?"s":""} will be locked${m===monthOf(ago(0))?" and no new rows can be added until it is reopened":""}.`,[{k:"n",label:"Note (optional)",attr:'maxlength="120"'}],"Close month");
    if(!v||pClosed(m))return;
    st.paymentCloses.push({id:uid(),m,by:u.id,ts:new Date().toISOString(),rows:n,note:v.n});
    log("payments.month.close",`${fmtMonth(m)} · ${n} rows${v.n?" – "+v.n:""}`);flash(`${fmtMonth(m)} closed.`);commit();
  },
  payreopen:async()=>{
    const u=me(),m=ui.p&&ui.p.month,c=m&&pClosed(m);
    if(!c)return;
    if(u.role!=="manager")return flash("Only a manager can reopen a month.",1);
    if(c.m!==pLastClosed())return flash("Reopen the most recent closed month first.",1);
    const v=await ask(`Reopen ${fmtMonth(m)}`,[{k:"r",label:"Reason",req:1,attr:'maxlength="100"'}],"Reopen");if(!v)return;
    st.paymentCloses=st.paymentCloses.filter(x=>x.id!==c.id);
    log("payments.month.reopen",`${fmtMonth(m)} – ${v.r}`);flash(`${fmtMonth(m)} reopened.`);commit();
  }
});
inputs.pmonth=el=>{if(!ui.p||ui.p.month===el.value)return;ui.p.month=el.value;ui.p.rows.forEach(r=>{if(!pVisible(r))r.sel=false});renderPay()};

document.addEventListener("keydown",e=>{
  const el=e.target;
  if(!(el.classList&&el.classList.contains("pc"))||!ui.p||e.ctrlKey||e.metaKey||e.altKey)return;
  const R=ui.p.rows,i=+el.dataset.r,j=+el.dataset.c,k=e.key,last=PCOLS.length-1,sel=el.tagName==="SELECT";
  const V=R.map((r,x)=>x).filter(x=>pVisible(R[x])),p=V.indexOf(i);
  const go=(a,b)=>{e.preventDefault();pFocus(a,b)};
  const len=sel?0:el.value.length,s=sel?0:el.selectionStart,t=sel?0:el.selectionEnd;
  if(k==="Enter"){
    if(e.shiftKey){if(p>0)go(V[p-1],j);else e.preventDefault()}
    else if(p<V.length-1)go(V[p+1],j);
    else{e.preventDefault();if(!pBlank(R[i]))pAdd(j)}
  }
  else if(k==="ArrowDown"){if(p<V.length-1)go(V[p+1],j);else if(sel)e.preventDefault()}
  else if(k==="ArrowUp"){if(p>0)go(V[p-1],j);else if(sel)e.preventDefault()}
  else if(k==="ArrowLeft"){if(j>0&&(sel||(s===0&&(t===0||t===len))))go(i,j-1)}
  else if(k==="ArrowRight"){if(j<last&&(sel||(t===len&&(s===len||s===0))))go(i,j+1)}
  else if(k==="Tab"&&!e.shiftKey&&p===V.length-1&&j===last&&!pBlank(R[i])){e.preventDefault();pAdd(0)}
});
document.addEventListener("focusin",e=>{const el=e.target;if(el.classList&&el.classList.contains("pc")&&el.tagName==="INPUT")setTimeout(()=>{if(document.activeElement===el)el.select()},0)});
document.addEventListener("input",e=>{
  const el=e.target;if(!(el.classList&&el.classList.contains("pc"))||!ui.p)return;
  const i=+el.dataset.r;ui.p.rows[i].v[+el.dataset.c]=el.value;ui.p.dirty=true;pStat();pPaint(i);
});
document.addEventListener("change",e=>{
  const el=e.target;if(!ui.p||!el.dataset)return;
  if(el.classList.contains("pc")){
    const i=+el.dataset.r,j=+el.dataset.c,r=ui.p.rows[i],v=pNorm(PCOLS[j],el.value);
    if(el.tagName==="INPUT")el.value=v;r.v[j]=v;r.touch[j]=true;ui.p.dirty=true;pPaint(i);pSummary();pStat();
  }else if(el.dataset.psel!==undefined){
    const i=+el.dataset.psel;ui.p.rows[i].sel=el.checked;el.closest("tr").classList.toggle("sel",el.checked);
    const all=$("pall");if(all)all.checked=ui.p.rows.filter(pVisible).every(r=>r.sel||pLocked(r.d));
  }else if(el.id==="pall"){ui.p.rows.forEach(r=>{if(pVisible(r)&&!pLocked(r.d))r.sel=el.checked});renderPay()}
});
document.addEventListener("paste",e=>{
  const el=e.target;if(!(el.classList&&el.classList.contains("pc"))||!ui.p)return;
  const raw=((e.clipboardData||window.clipboardData).getData("text")||"").replace(/\r?\n$/,"");
  if(!/[\t\r\n]/.test(raw))return; // a single value: let the browser paste it normally
  e.preventDefault();
  let M=gTsv(raw).map(row=>row.map(x=>x.replace(/\s*\n\s*/g," ")));
  if(M[0].some(h=>PCOLS.some(c=>c.label.toLowerCase()===h.trim().toLowerCase())))M=M.slice(1); // skip a pasted header row
  if(!M.length)return;
  const R=ui.p.rows,V=R.map((r,x)=>x).filter(x=>pVisible(R[x])),r0=+el.dataset.r,c0=+el.dataset.c,p0=V.indexOf(r0),cm=monthOf(ago(0));
  let msg="";
  const extra=Math.max(0,p0+M.length-V.length);
  if(extra&&pLocked(ago(0)))return flash(`${fmtMonth(cm)} is closed, so new rows cannot be added.`,1);
  if(extra&&R.length+extra>PMAX){M=M.slice(0,V.length-p0+(PMAX-R.length));msg=` Stopped at the ${PMAX}-row limit.`}
  for(let i=0;i<M.length;i++){const x=V[p0+i];if(x!==undefined&&pLocked(R[x].d))return flash("The pasted block reaches rows in a closed month. Nothing was pasted.",1)}
  if(p0+M.length>V.length&&ui.p.month&&ui.p.month!==cm)ui.p.month=""; // show new rows next to the old ones
  let cut=false;
  M.forEach((row,i)=>{
    let x=V[p0+i];if(x===undefined){R.push(pNew());x=R.length-1;V.push(x)}
    const r=R[x];row.forEach((val,j)=>{const cj=c0+j;if(cj>=PCOLS.length){cut=true;return}r.v[cj]=pNorm(PCOLS[cj],val);r.touch[cj]=true});
  });
  ui.p.dirty=true;renderPay();pFocus(r0,c0);
  flash(`Pasted ${M.length} row${M.length>1?"s":""}.`+(cut?" Extra columns were ignored.":"")+msg);
});
window.addEventListener("beforeunload",e=>{if(ui.p&&ui.p.dirty){e.preventDefault();e.returnValue=""}});

document.addEventListener("click",e=>{const b=e.target.closest("[data-act]");if(b&&acts[b.dataset.act])acts[b.dataset.act](b)});
document.addEventListener("submit",e=>{if(forms[e.target.id]){e.preventDefault();forms[e.target.id]()}});
["input","change"].forEach(ev=>document.addEventListener(ev,e=>{
  const el=e.target;
  if(ev==="change"&&el.dataset&&el.dataset.chg&&chg[el.dataset.chg])return chg[el.dataset.chg](el);
  if(el.id&&inputs[el.id])inputs[el.id](el);
}));
render();
</script>
<script id="polish-js">
/* ===== Cashbook UX add-on =====
   Read-only helper: never touches st, ui, localStorage or any app function.
   It only reads the DOM the app already renders and adds titles / ARIA hints. */
(function(){
  "use strict";
  var app=document.getElementById("app");
  if(!app||!window.MutationObserver)return;
  var BASE="Cashbook";
  var pending=false;

  function enhance(){
    pending=false;
    try{
      // 1. Browser tab title shows the current section
      var on=app.querySelector("nav button.on");
      document.title=on?on.textContent.replace(/\d+$/,"").trim()+" · "+BASE:BASE+" · Sign in";

      // 2. Accessibility: mark current tab, label the nav landmark
      var nav=app.querySelector("nav");
      if(nav){nav.setAttribute("aria-label","Sections");}
      app.querySelectorAll("nav button").forEach(function(b){
        if(b.classList.contains("on"))b.setAttribute("aria-current","page");
        else b.removeAttribute("aria-current");
      });

      // 3. Make wide tables obviously scrollable on small screens
      app.querySelectorAll(".tw,.gw").forEach(function(w){
        w.setAttribute("tabindex","0");
        if(!w.getAttribute("role")){w.setAttribute("role","region");}
        if(!w.getAttribute("aria-label")){w.setAttribute("aria-label","Scrollable table");}
      });

      // 4. Helpful hints on login fields
      var pin=document.getElementById("lp");
      if(pin){pin.setAttribute("placeholder","Enter your PIN");pin.setAttribute("aria-describedby","err");}

      // 5. Money columns: right-aligned numbers read better when negatives stand out
      app.querySelectorAll("td.num").forEach(function(td){
        var t=td.textContent.trim();
        if(t.charAt(0)==="\u2212"&&!td.classList.contains("out-t"))td.classList.add("out-t");
      });
    }catch(e){/* cosmetic only: never break the app */}
  }

  function schedule(){
    if(pending)return;pending=true;
    (window.requestAnimationFrame||setTimeout)(enhance);
  }

  new MutationObserver(schedule).observe(app,{childList:true,subtree:true});

  // Keyboard: "/" focuses the first search box on the page (like most modern tools)
  document.addEventListener("keydown",function(e){
    if(e.key!=="/"||e.ctrlKey||e.metaKey||e.altKey)return;
    var t=e.target,tag=(t&&t.tagName)||"";
    if(tag==="INPUT"||tag==="SELECT"||tag==="TEXTAREA"||(t&&t.isContentEditable))return;
    var s=document.querySelector('input[type="search"]');
    if(s){e.preventDefault();s.focus();}
  });

  // Keep the sticky nav tucked under the sticky header whatever its real height is
  function stick(){
    var h=app.querySelector("header"),n=app.querySelector("nav");
    if(h&&n&&window.innerWidth>820)n.style.top=h.offsetHeight+"px";
    else if(n)n.style.top="";
  }
  window.addEventListener("resize",stick);
  new MutationObserver(stick).observe(app,{childList:true});

  schedule();stick();
})();

</script>
