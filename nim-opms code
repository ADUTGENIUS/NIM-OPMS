const crcT=(()=>{const t=new Uint32Array(256);for(let n=0;n<256;n++){let c=n;for(let k=0;k<8;k++)c=c&1?0xEDB88320^(c>>>1):c>>>1;t[n]=c}return t})();
const crc32=b=>{let c=0xFFFFFFFF;for(let i=0;i<b.length;i++)c=crcT[(c^b[i])&255]^(c>>>8);return(c^0xFFFFFFFF)>>>0};
function zipParts(files){ // "stored" (uncompressed) zip
  const enc=new TextEncoder(),out=[],cd=[];let off=0;
  const w16=n=>[n&255,(n>>>8)&255],w32=n=>[n&255,(n>>>8)&255,(n>>>16)&255,(n>>>24)&255];
  for(const[name,txt]of files){
    const nb=enc.encode(name),db=enc.encode(txt),c=crc32(db);
    const lh=new Uint8Array([0x50,0x4b,3,4,...w16(20),...w16(0x800),...w16(0),...w16(0),...w16(0x21),...w32(c),...w32(db.length),...w32(db.length),...w16(nb.length),...w16(0)]);
    out.push(lh,nb,db);
    cd.push(new Uint8Array([0x50,0x4b,1,2,...w16(20),...w16(20),...w16(0x800),...w16(0),...w16(0),...w16(0x21),...w32(c),...w32(db.length),...w32(db.length),...w16(nb.length),...w16(0),...w16(0),...w16(0),...w16(0),...w32(0),...w32(off)]),nb);
    off+=lh.length+nb.length+db.length;
  }
  const cdLen=cd.reduce((s,a)=>s+a.length,0);
  const end=new Uint8Array([0x50,0x4b,5,6,...w16(0),...w16(0),...w16(files.length),...w16(files.length),...w32(cdLen),...w32(off),...w16(0)]);
  return[...out,...cd,end];
}
