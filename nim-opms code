  const R=ui.g.rows,i=+el.dataset.r,j=+el.dataset.c,k=e.key,last=GCOLS.length-1,sel=el.tagName==="SELECT";
  const V=R.map((r,x)=>x).filter(x=>gVisible(R[x])),p=V.indexOf(i);
  const go=(a,b)=>{e.preventDefault();gFocus(a,b)};
  const len=sel?0:el.value.length,s=sel?0:el.selectionStart,t=sel?0:el.selectionEnd;
  if(k==="Enter"){
    if(e.shiftKey){if(p>0)go(V[p-1],j);else e.preventDefault()}
