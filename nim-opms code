    BCOLS.map((c,j)=>{const e=bCellErr(r,j);return`<td${e?` class="bad" title="${esc(e)}"`:""}><input class="rc${c.num?" r":""}" data-r="${i}" data-c="${j}" value="${esc(r.v[j])}" maxlength="${c.max||16}"${c.num?' inputmode="decimal"':""}${lk?" readonly":""} autocomplete="off" aria-label="${esc(c.label)}, row ${n}"${e?' aria-invalid="true"':""}></td>`}).join("")+"</tr>";
