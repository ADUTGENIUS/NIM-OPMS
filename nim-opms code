/* =====================================================================
   DATA — PDF-only documents. Each PDF must be named; it can be downloaded any time.
   Details (name, size, who, when) live in st.docs; the file itself is kept in IndexedDB.
   ===================================================================== */
const MAXPDF=10*1024*1024;
const idb=(()=>{
  let p=null;
  const open=()=>p||(p=new Promise((res,rej)=>{
    if(!window.indexedDB)return rej(new Error("no indexedDB"));
    const q=indexedDB.open("cashbook.files",1);
    q.onupgradeneeded=()=>q.result.createObjectStore("f");
    q.onsuccess=()=>res(q.result);q.onerror=()=>rej(q.error);
  }).catch(e=>{p=null;throw e}));
  const run=(mode,fn)=>open().then(db=>new Promise((res,rej)=>{
    const t=db.transaction("f",mode),req=fn(t.objectStore("f"));
    t.oncomplete=()=>res(req.result);t.onerror=t.onabort=()=>rej(t.error);
  }));
  return{put:(k,v)=>run("readwrite",s=>s.put(v,k)),get:k=>run("readonly",s=>s.get(k)),del:k=>run("readwrite",s=>s.delete(k))};
})();
const readBuf=f=>f.arrayBuffer?f.arrayBuffer():new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=()=>rej(r.error);r.readAsArrayBuffer(f)});
const fsize=b=>b<1048576?Math.max(1,Math.round(b/1024))+" KB":(b/1048576).toFixed(1)+" MB";
const fname=n=>(n.replace(/[\\\/:*?"<>|\u0000-\u001f]/g,"_").replace(/\s+/g," ").trim().slice(0,80)||"document")+".pdf";
