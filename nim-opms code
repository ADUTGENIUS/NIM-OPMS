Object.assign(acts,{
  bondadd:()=>bAdd(0),bonddel:bDelete,bondsave:bSave,bondxlsx:bExport,
  bclose:async()=>{
    const u=me(),g=ui.b,m=g&&g.month;
    if(!canCloseMonth(u))return flash("You do not have authority to close a month.",1);
    if(!m)return flash("Choose the month you want to close.",1);
    if(bClosed(m))return flash("This month is already closed.",1);
