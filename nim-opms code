  <label>Month<select id="pmonth"><option value=""${m===""?" selected":""}>All months</option>${ms.map(x=>`<option value="${x}"${x===m?" selected":""}>${esc(fmtMonth(x))}${pClosed(x)?" (closed)":""}</option>`).join("")}</select></label>
